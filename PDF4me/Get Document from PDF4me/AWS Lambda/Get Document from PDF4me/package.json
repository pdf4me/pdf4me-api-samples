{
  "name": "pdf4me-get-document-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda function for PDF4me PDF splitting by barcode",
  "main": "get_document_from_pdf4me_lambda.js",
  "dependencies": {
    "axios": "^1.10.0"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0"
  },
  "scripts": {
    "start": "node get_document_from_pdf4me_lambda.js",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "offline": "serverless offline",
    "logs": "serverless logs -f getDocumentFromPdf4me -t"
  },
  "keywords": [
    "pdf4me",
    "pdf-splitting",
    "barcode-splitting",
    "aws-lambda",
    "serverless"
  ],
  "author": "PDF4me",
  "license": "MIT"
} 