{
  "name": "pdf4me-add-html-header-footer-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda function for PDF4me Add HTML Header Footer to PDF",
  "main": "add_html_header_footer_lambda.js",
  "scripts": {
    "start": "node add_html_header_footer_lambda.js",
