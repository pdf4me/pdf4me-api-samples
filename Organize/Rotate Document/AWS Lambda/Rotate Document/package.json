{
  "name": "pdf4me-rotate-document-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda function for PDF4me PDF document rotation (entire document)",
  "main": "rotate_document_lambda.js",
  "scripts": {
    "start": "node rotate_document_lambda.js",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "offline": "serverless offline",
    "logs": "serverless logs -f rotateDocument"
  },
  "keywords": [
    "pdf4me",
    "pdf",
    "rotate-document",
    "aws-lambda",
    "serverless",
    "document-processing"
  ],
  "author": "PDF4me",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0"
  }
} 