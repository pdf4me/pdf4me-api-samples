{
  "name": "pdf4me-disable-tracking-changes-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda function for PDF4me Word document tracking changes disable",
  "main": "disable_tracking_changes_in_word_lambda.js",
  "scripts": {
    "start": "node disable_tracking_changes_in_word_lambda.js",
